APP_NAME=Deposit360
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./deposit360.db
DATABASE_ECHO=false
STORAGE_LOCAL_PATH=./_storage
MAX_UPLOAD_SIZE_MB=20
BANK_VERIFICATION_ADAPTER=mock
BANK_VERIFICATION_URL=
BANK_VERIFICATION_API_KEY=
EMAIL_DELIVERY_ADAPTER=log
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
SMS_DELIVERY_ADAPTER=log
SMS_DELIVERY_URL=
SMS_DELIVERY_API_KEY=
LIFECYCLE_SCHEDULER_ENABLED=true
LIFECYCLE_SCHEDULER_INTERVAL_SECONDS=3600
MATURITY_REMINDER_INTERVAL_DAYS=1
TESSERACT_CMD=